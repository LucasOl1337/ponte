#!/usr/bin/env python3
"""Synthetic monitor: a coordinate grid, three labelled targets (the two
fields toggle the fcitx focus flag), the cursor, the last clicks and whatever
was typed. Honors grim's -s scale, -t type and -q quality; always writes to stdout."""
import sys, os, io
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import _lab
from PIL import Image, ImageDraw, ImageFont
args = sys.argv[1:]
def opt(flag, default):
    return args[args.index(flag) + 1] if flag in args else default
scale = float(opt('-s', '1')); kind = opt('-t', 'png'); quality = int(opt('-q', '80'))
m = _lab.monitor(); W, H = m['width'], m['height']
s = _lab.load()
im = Image.new('RGB', (W, H), (24, 26, 22)); d = ImageDraw.Draw(im)
def load_font(size):
    for candidate in ('/usr/share/fonts/TTF/DejaVuSansMono.ttf', '/usr/share/fonts/liberation/LiberationMono-Regular.ttf', '/usr/share/fonts/TTF/JetBrainsMonoNerdFont-Regular.ttf'):
        try: return ImageFont.truetype(candidate, size)
        except OSError: continue
    return ImageFont.load_default()
font, big = load_font(22), load_font(40)
for x in range(0, W, 100):
    d.line([(x, 0), (x, H)], fill=(60, 64, 56) if x % 500 else (110, 120, 96), width=1)
    if x % 200 == 0: d.text((x + 4, 4), str(x), fill=(150, 160, 130), font=font)
for y in range(0, H, 100):
    d.line([(0, y), (W, y)], fill=(60, 64, 56) if y % 500 else (110, 120, 96), width=1)
    if y % 200 == 0: d.text((4, y + 4), str(y), fill=(150, 160, 130), font=font)
for name, kind_, (x, y, w, h) in _lab.targets():
    d.rectangle([x, y, x + w, y + h], outline=(213, 248, 136), width=3, fill=(40, 46, 34) if kind_ == 'field' else (70, 90, 50))
    d.text((x + 10, y + 18), f'{name} {kind_} {int(x)},{int(y)}', fill=(240, 240, 220), font=font)
c = s['cursor']
for i, click in enumerate(s['clicks']):
    age = len(s['clicks']) - i
    col = (255, 90, 90) if click['button'] == 'right' else (120, 200, 255)
    r = 10 + 2 * age
    d.ellipse([click['x'] - r, click['y'] - r, click['x'] + r, click['y'] + r], outline=col, width=2)
    d.text((click['x'] + r + 2, click['y'] - 12), f"{click['x']},{click['y']}", fill=col, font=font)
d.line([(c['x'] - 30, c['y']), (c['x'] + 30, c['y'])], fill=(255, 255, 255), width=3)
d.line([(c['x'], c['y'] - 30), (c['x'], c['y'] + 30)], fill=(255, 255, 255), width=3)
d.text((c['x'] + 14, c['y'] + 14), f"cursor {c['x']},{c['y']}" + (' HELD' if s['held'] else ''), fill=(255, 255, 255), font=big)
d.rectangle([20, H - 120, W - 20, H - 20], fill=(30, 34, 28), outline=(110, 120, 96))
d.text((30, H - 110), 'typed: ' + s['typed'][-90:], fill=(213, 248, 136), font=big)
d.text((30, H - 60), f"profile {s['profile']} · accel {s['accel']} · text focus {'on' if s.get('textFocus') else 'off'}", fill=(150, 160, 130), font=font)
if scale != 1: im = im.resize((max(1, round(W * scale)), max(1, round(H * scale))), Image.BILINEAR)
out = io.BytesIO()
if kind == 'jpeg': im.save(out, 'JPEG', quality=quality)
else: im.save(out, 'PNG')
sys.stdout.buffer.write(out.getvalue())
