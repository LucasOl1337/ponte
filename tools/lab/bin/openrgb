#!/usr/bin/env python3
"""Fake OpenRGB 1.0rc3 CLI. Like the real one, every --device is resolved
(case-insensitive substring, every match) before anything applies, and one
miss prints 'Error: Cannot find device' and exits 255 with nothing applied.
PONTE_LAB_OPENRGB_DEVICES ('|'-separated) is what is on the bus: by default
this PC's list with the Logitech keyboard asleep. PONTE_LAB_OPENRGB_FAIL
names devices whose write fails."""
import os, sys
from _lab import log

DEFAULT = 'ENE DRAM|ENE DRAM|Corsair Vengeance RGB DDR5|Corsair Vengeance RGB DDR5|ASUS TUF GeForce RTX 4070 Ti SUPER Gaming White OC|MSI B650M PROJECT ZERO (MS-7E09)'
present = [d for d in os.environ.get('PONTE_LAB_OPENRGB_DEVICES', DEFAULT).split('|') if d]
broken = [d for d in os.environ.get('PONTE_LAB_OPENRGB_FAIL', '').split('|') if d]
args = sys.argv[1:]
names = [args[i + 1] for i, v in enumerate(args[:-1]) if v in ('--device', '-d')]
for name in names:
    if not any(name.lower() in d.lower() for d in present):
        log('openrgb', args, {'result': 'missing', 'device': name})
        print(f'Error: Cannot find device "{name}"\nRun `OpenRGB --help` for syntax')
        sys.exit(255)
for name in names:
    if any(b.lower() in name.lower() for b in broken):
        log('openrgb', args, {'result': 'failed', 'device': name})
        print(f'i2c write failed on {name}', file=sys.stderr)
        sys.exit(1)
log('openrgb', args, {'result': 'applied', 'devices': [d for d in present if any(n.lower() in d.lower() for n in names)]})
