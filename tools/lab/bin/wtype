#!/usr/bin/env python3
import sys, os
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import _lab
text = sys.stdin.read() if sys.argv[1:] == ['-'] else ' '.join(sys.argv[1:])
with _lab.locked():
    s = _lab.load(); s['typed'] = (s['typed'] + text)[-400:]; _lab.save(s)
_lab.log('wtype', sys.argv[1:], {'text': text})
