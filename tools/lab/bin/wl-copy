#!/usr/bin/env python3
"""Fake wl-copy: never touches a real clipboard. Keeps the last copy in
$PONTE_LAB_DIR/clipboard.bin and logs type, size and sha256."""
import sys, os, hashlib
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import _lab
data = sys.stdin.buffer.read()
args = sys.argv[1:]
mime = args[args.index('--type') + 1] if '--type' in args else None
with _lab.locked():
    with open(os.path.join(_lab.LAB, 'clipboard.bin'), 'wb') as f: f.write(data)
_lab.log('wl-copy', args, {'type': mime, 'bytes': len(data), 'sha256': hashlib.sha256(data).hexdigest(), 'magic': data[:4].hex()})
