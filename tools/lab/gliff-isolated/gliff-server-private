#!/usr/bin/env python3
"""Fail-closed gliff-server adapter: only the harness's explicit private sockets."""
import os, sys, json, socket
from pathlib import Path
root=Path(__file__).resolve().parent
if sys.argv[1:]==['--version']:
    os.execv('/usr/bin/gliff-server',['gliff-server','--version'])
state=json.loads((root/'state.json').read_text())
runtime=Path(f'/run/user/{os.getuid()}/pg-proof')
assert state['runtime']==str(runtime)
sig=state['instance']; assert '/' not in sig and sig
ipc=runtime/'hypr'/sig/'.socket.sock'
assert ipc.is_socket()
assert (runtime/state['wayland']).is_socket()
with socket.socket(socket.AF_UNIX) as sock:
    sock.connect(str(ipc)); sock.sendall(b'j/monitors'); monitors=json.loads(sock.recv(65536))
assert monitors and all(m['name']=='PROOF' for m in monitors), monitors
os.environ.update(XDG_RUNTIME_DIR=str(runtime),HYPRLAND_INSTANCE_SIGNATURE=sig,WAYLAND_DISPLAY=state['wayland'])
os.environ.pop('DISPLAY',None)
os.environ.pop('DBUS_SESSION_BUS_ADDRESS',None)
(root/'server.pid').write_text(str(os.getpid()))
with open(root/'server-launches.jsonl','a') as log:
    log.write(json.dumps({'pid':os.getpid(),'runtime':str(runtime),'instance':sig,'outputs':[m['name'] for m in monitors],'args':sys.argv[1:]})+'\n')
os.execv('/usr/bin/gliff-server',['gliff-server','--instance',sig,'--capture','shm','--video','cpu',*sys.argv[1:]])
