def certificate_dates(path):
    text = run('openssl', 'x509', '-in', str(path), '-noout', '-enddate', '-fingerprint', '-sha256', capture=True).stdout
    end = re.search(r'notAfter=(.+)', text)
    fingerprint = re.search(r'Fingerprint=(.+)', text)
    from datetime import datetime, timezone
    expires = datetime.strptime(end.group(1).strip(), '%b %d %H:%M:%S %Y %Z').replace(tzinfo=timezone.utc)
    return expires, (fingerprint.group(1).strip() if fingerprint else '')


def doctor(config_file):
    """Check every link between this PC and the phone, in the order they can fail."""
    import hashlib
    import http.client
    import ssl
    import zipfile
    from datetime import datetime, timezone
    problems = 0

    def report(status, message):
        nonlocal problems
        if status != 'ok':
            problems += 1
        print(f'[{status:>4}] {message}')

    if not config_file.is_file():
        report('fail', f'no configuration at {config_file}; run ./ponte setup')
        return 1
    config = load_config(config_file)
    tls = config.get('nativeTls')
    if not tls:
        report('warn', 'local-only installation: no Tailscale TLS listener, the Android app cannot connect')
        return 1
    host, port = tls['host'], tls['port']
    report('ok', f'configuration: TLS listener {host}:{port}')

    ca_cert, server_cert = Path(tls.get('caFile', '')), Path(tls['certFile'])
    now = datetime.now(timezone.utc)
    for label, path in [('installation CA', ca_cert), ('server certificate', server_cert)]:
        if not path.is_file():
            report('fail', f'{label} missing: {path}')
            continue
        expires, _ = certificate_dates(path)
        days = (expires - now).days
        if days < 0:
            report('fail', f'{label} expired {-days} days ago' + ('; run ./ponte renew-cert' if label.startswith('server') else '; run ./ponte setup again and rebuild the app'))
        elif days < 30:
            report('warn', f'{label} expires in {days} days' + ('; run ./ponte renew-cert' if label.startswith('server') else ''))
        else:
            report('ok', f'{label} valid for {days} days')

    try:
        status = json.loads(run('tailscale', 'status', '--json', capture=True).stdout)
        self_ips = status.get('Self', {}).get('TailscaleIPs', [])
        online = status.get('Self', {}).get('Online')
        if host not in self_ips:
            report('fail', f'Tailscale address changed: this PC is {", ".join(self_ips) or "offline"}, the app was built for {host}')
        elif not online:
            report('fail', 'Tailscale is not connected on this PC')
        else:
            report('ok', f'Tailscale connected as {host}')
        phones = [peer for peer in status.get('Peer', {}).values() if peer.get('OS') == 'android']
        for peer in phones:
            if not peer.get('Online') and (now - datetime.fromisoformat(peer.get('LastSeen', '0001-01-01T00:00:00Z').replace('Z', '+00:00'))).days > 30:
                continue  # a phone that has not been seen in a month is an old enrollment, not today's problem
            path = 'direct' if peer.get('CurAddr') else f"relay {peer.get('Relay') or '?'}"
            report('ok' if peer.get('Online') else 'warn', f"phone {peer.get('HostName')} ({peer.get('TailscaleIPs', ['?'])[0]}): {'online, ' + path if peer.get('Online') else 'offline'}")
    except (OSError, subprocess.SubprocessError, ValueError):
        report('fail', 'tailscale is not available on this PC')

    for unit in [SERVICE, 'ponte-input.service']:
        active = subprocess.run(['systemctl', '--user', 'is-active', '--quiet', unit]).returncode == 0
        report('ok' if active else 'fail', f'{unit} {"running" if active else "not running; ./ponte start, then ./ponte logs"}')
    if not shutil.which('ydotoold'):
        report('fail', 'ydotoold not found: touch input cannot reach the desktop (a snapshot boot? check /proc/cmdline)')

    context = ssl.create_default_context(cafile=str(ca_cert)) if ca_cert.is_file() else None
    if context:
        context.check_hostname = False  # the SAN is an IP; verify_ip below covers it
        try:
            connection = http.client.HTTPSConnection(host, port, context=context, timeout=5)
            connection.request('GET', '/api/health')
            response = connection.getresponse()
            body = json.loads(response.read())
            peer = ssl.DER_cert_to_PEM_cert(connection.sock.getpeercert(binary_form=True))
            served = hashlib.sha256(peer.encode()).hexdigest()
            expected = hashlib.sha256(server_cert.read_bytes()).hexdigest() if server_cert.is_file() else None
            if response.status != 200:
                report('fail', f'/api/health answered {response.status}')
            elif not body.get('autoPair'):
                report('fail', 'auto-pairing disabled on the listener (PONTE_TAILSCALE_AUTO=0?)')
            else:
                report('ok', f'TLS listener answers, version {body.get("version")}')
            if expected and served != expected:
                report('warn', 'the running service serves an older certificate than the one on disk; ./ponte restart')
            connection.close()
            connection = http.client.HTTPSConnection(host, port, context=context, timeout=5)
            connection.request('GET', '/api/pair')
            response = connection.getresponse()
            response.read()
            if response.status == 200:
                report('ok', 'auto-pairing: this PC is recognized as the tailnet owner')
            else:
                report('fail', f'auto-pairing denied ({response.status}): the owner was not resolved; tailscale whois {host} must answer, then ./ponte restart')
            connection.close()
        except (OSError, ssl.SSLError, ValueError) as error:
            report('fail', f'TLS listener unreachable at {host}:{port}: {error}')

    apk = Path(__file__).resolve().parent / '.work' / 'Ponte.apk'
    if not apk.is_file():
        report('warn', 'no APK built yet: ./android/build.sh')
    else:
        try:
            with zipfile.ZipFile(apk) as archive:
                names = set(archive.namelist())
                if 'assets/pc-ca.pem' in names:
                    same = ca_cert.is_file() and archive.read('assets/pc-ca.pem') == ca_cert.read_bytes()
                    report('ok' if same else 'fail', 'APK pins ' + ('the current installation CA' if same else 'a different CA; rebuild with ./android/build.sh and reinstall on the phone'))
                elif 'assets/pc-certificate.pem' in names:
                    report('fail', 'APK is an old build that pins the server certificate; rebuild with ./android/build.sh and reinstall on the phone')
                else:
                    report('fail', 'APK carries no trust anchor; rebuild with ./android/build.sh')
        except zipfile.BadZipFile:
            report('fail', f'{apk} is not a valid APK')
        version = config.get('android', {}).get('versionName')
        if version and shutil.which('adb'):
            serial = os.environ.get('ANDROID_SERIAL')
            if not serial:
                # Prefer the phone's Tailscale address (the transport agents use),
                # then any physical phone, then an emulator.
                devices = subprocess.run(['adb', 'devices'], capture_output=True, text=True, timeout=15).stdout
                attached = [line.split('\t')[0] for line in devices.splitlines()[1:] if line.endswith('\tdevice')]
                tailnet = load_phone_address(config_file, paths()[1])
                serial = tailnet if tailnet in attached else next((s for s in attached if not s.startswith('emulator-')), attached[0] if attached else None)
                if tailnet in attached:
                    report('ok', f'phone adb over Tailscale: {tailnet} (no USB or Wi-Fi needed)')
                else:
                    report('warn', f'phone adb over Tailscale: {tailnet} not connected; run ./ponte phone ensure')
            command = ['adb', *(['-s', serial] if serial else []), 'shell', 'dumpsys', 'package', 'app.ponte.omarchy']
            probe = subprocess.run(command, capture_output=True, text=True, timeout=15)
            match = re.search(r'versionName=(\S+)', probe.stdout)
            if probe.returncode != 0 or 'more than one device' in probe.stderr:
                report('warn', 'phone not reachable over adb (optional): ' + (probe.stderr.strip().splitlines() or ['no device'])[-1])
            elif not match:
                report('warn', 'phone reachable over adb but Ponte is not installed')
            elif match.group(1) != version:
                report('warn', f'phone runs Ponte {match.group(1)}, this PC builds {version}; install the new APK')
            else:
                report('ok', f'phone runs Ponte {version}, same as this build')

    print('All checks passed.' if problems == 0 else f'{problems} check(s) need attention.')
    return 0 if problems == 0 else 1


def local_api(config_file, method, route, body=None, timeout=20):
    """Call this node's own server on its loopback listener with the owner token."""
    import urllib.error
    import urllib.request
    config = load_config(config_file)
    data = absolute(os.environ.get('OMARCHY_REMOTE_DATA', config['dataDir']), 'dataDir')
    token = (data / 'token').read_text().strip()
    if not re.fullmatch(r'[a-zA-Z0-9_-]{32,128}', token):
        raise ValueError('Invalid pairing token.')
    host, port_value = config['http']['host'], config['http']['port']
    authority = f'[{host}]' if ':' in host else host
    payload = None if body is None else json.dumps(body).encode()
    request = urllib.request.Request(f'http://{authority}:{port_value}/api{route}', data=payload, method=method, headers={
        'Authorization': f'Bearer {token}', 'Accept-Language': 'pt' if os.environ.get('LANG', '').startswith('pt') else 'en',
        **({'Content-Type': 'application/json'} if payload is not None else {})})
    # Never through an HTTP proxy from the environment: this is loopback.
    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
    try:
        with opener.open(request, timeout=timeout) as response:
            return json.load(response)
    except urllib.error.HTTPError as error:
        try:
            detail = json.load(error)
        except ValueError:
            detail = {}
        raise ValueError(detail.get('error') or f'Ponte answered HTTP {error.code}.') from None
    except urllib.error.URLError as error:
        raise ValueError(f'Ponte is not answering on {authority}:{port_value}. Start it with ./ponte start.') from error


def print_mesh(listing):
    me = listing.get('self') or {}
    print(f"This device: {me.get('name')} ({me.get('id')})")
    peers = listing.get('peers') or []
    if not peers:
        print('No other Ponte device found on your Tailscale.')
    for peer in peers:
        state = 'paired' if peer.get('paired') else 'available'
        pairing = peer.get('pairing') or {}
        if pairing.get('status') == 'pending':
            state = f"waiting for approval, code {pairing.get('code')}"
        elif pairing.get('status') in ('denied', 'expired'):
            state = f"request {pairing['status']}"
        extra = ', controls this device' if peer.get('controlsMe') else ''
        print(f"  {peer.get('name'):<24} {'online ' if peer.get('online') else 'offline'}  {state}{extra}  [{peer.get('id')}]")
    for item in listing.get('requests') or []:
        print(f"Request: {item.get('name')} ({item.get('ip')}) asks to control this device, code {item.get('code')}. ./ponte mesh approve {item.get('code')}")
    controllers = listing.get('controllers') or []
    if controllers:
        print('Devices that control this one:')
        for item in controllers:
            print(f"  {item.get('name'):<24} {item.get('ip')}  last seen {item.get('lastSeen') or 'never'}  [{item.get('id')}]")


def mesh_main(argv, sleep=time.sleep):
    parser = argparse.ArgumentParser(prog='ponte mesh', description='Pair this device with other Ponte devices on your Tailscale and control them.')
    sub = parser.add_subparsers(dest='action', required=True)
    sub.add_parser('list', help='This device, Ponte devices on the tailnet, pending requests and who controls this one.')
    pair = sub.add_parser('pair', help='Ask another device for access. Approve it there with the code shown here.')
    pair.add_argument('device', help='Name or id from ./ponte mesh list.')
    pair.add_argument('--no-wait', action='store_true', help='Print the code and return without waiting for the approval.')
    for name, text in [('approve', 'Approve a request for this device by its code.'), ('deny', 'Deny a request for this device by its code.')]:
        sub.add_parser(name, help=text).add_argument('code')
    sub.add_parser('revoke', help='Cut a link in either direction: a device this one controls or one that controls it.').add_argument('device')
    parser.add_argument('--json', action='store_true', help='Print the server answer as JSON.')
    args = parser.parse_args(argv)
    config_file, _, _ = paths()
    emit = (lambda value: print(json.dumps(value, indent=2))) if args.json else None
    if args.action == 'list':
        listing = local_api(config_file, 'GET', '/mesh')
        return emit(listing) if emit else print_mesh(listing)
    if args.action in ('approve', 'deny'):
        result = local_api(config_file, 'POST', f'/mesh/{args.action}', {'code': args.code})
        if emit:
            return emit(result)
        who = (result.get('approved') or result.get('denied') or {}).get('name')
        print(f'Approved: {who} can now control this device.' if args.action == 'approve' else f'Denied the request from {who}.')
        return
    if args.action == 'revoke':
        result = local_api(config_file, 'POST', '/mesh/revoke', {'peer': args.device})
        if emit:
            return emit(result)
        print(f"Revoked: {result['revoked']['name']} no longer linked with this device.")
        return
    result = local_api(config_file, 'POST', '/mesh/pair', {'peer': args.device})
    peer = result.get('peer') or {}
    if result.get('status') == 'paired':
        print(f"Already paired with {peer.get('name')}.")
        return
    print(f"Code {result.get('code')}: approve it on {peer.get('name')} (Devices card, or ./ponte mesh approve {result.get('code')} there).")
    if args.no_wait:
        return
    deadline = time.monotonic() + 10 * 60
    while time.monotonic() < deadline:
        sleep(2)
        listing = local_api(config_file, 'GET', '/mesh')
        entry = next((item for item in listing.get('peers') or [] if item.get('id') == peer.get('id')), {})
        if entry.get('paired'):
            print(f"Paired: this device now controls {peer.get('name')}.")
            return
        status = (entry.get('pairing') or {}).get('status')
        if status in ('denied', 'expired'):
            raise ValueError(f"The request was {status} on {peer.get('name')}.")
    raise ValueError('No answer within 10 minutes.')


def pc_main(argv):
    # SSH-friendly local control over Tailscale. Reuses the Node desktop actions
    # (power, lock, unlock, monitors, RGB) validated by the server, so `ssh
    # lol@<tailscale-ip> ponte pc <command>` needs no HTTP server or pairing.
    helper = Path(__file__).resolve().parent / 'bin' / 'ponte-pc.mjs'
    node = os.environ.get('PONTE_NODE', 'node')
    if not argv or argv[0] in ('-h', '--help'):
        print('Usage: ./ponte pc <lock|unlock|sleep|wake|suspend|reboot|off|monitors on|off [NAME]|lights NAME>')
        print("unlock reads the password from stdin: echo -n 'pw' | ./ponte pc unlock")
        if argv:
            return
        raise SystemExit(2)
    try:
        raise SystemExit(subprocess.call([node, str(helper), *argv]))
    except FileNotFoundError:
        raise ValueError('node was not found. Install Node.js 22+ or set PONTE_NODE.')


NODE_ID = re.compile(r'[0-9a-f]{16}')


def local_origin(config):
    host = config['http']['host']
    authority = f'[{host}]' if ':' in host else host
    return f"http://{authority}:{config['http']['port']}"


def rd_node(origin, token, device):
    """Node id for a device name (or id) from the home node's /api/mesh; '' is this node."""
    from urllib.error import HTTPError, URLError
    from urllib.request import Request, urlopen
    try:
        request = Request(origin + '/api/mesh', headers={'Authorization': f'Bearer {token}', 'Accept': 'application/json'})
        with urlopen(request, timeout=5) as response:
            body = json.loads(response.read(1 << 20))
    except HTTPError as error:
        if NODE_ID.fullmatch(device):
            return device
        raise ValueError(f'The device list is unavailable (HTTP {error.code}); pass the node id instead of a name.') from error
    except (URLError, OSError, ValueError) as error:
        raise ValueError(f'Ponte is not answering at {origin}. Start it with ./ponte start.') from error
    mesh = body.get('mesh', body) if isinstance(body, dict) else {}
    self_node = mesh.get('self') or {}
    peers = [peer for peer in mesh.get('peers') or [] if isinstance(peer, dict) and peer.get('paired', True)]
    wanted = device.casefold()
    if wanted in (str(self_node.get('id', '')).casefold(), str(self_node.get('name', '')).casefold()):
        return ''
    for peer in peers:
        if wanted in (str(peer.get('id', '')).casefold(), str(peer.get('name', '')).casefold()):
            return str(peer['id'])
    names = ', '.join(str(peer.get('name') or peer.get('id')) for peer in peers) or 'none paired'
    raise ValueError(f'No paired device called {device!r} (known: {names}).')


def rd_browser():
    configured = os.environ.get('PONTE_CHROMIUM')
    for name in ([configured] if configured else ['chromium', 'chromium-browser', 'google-chrome-stable', 'google-chrome']):
        found = shutil.which(name)
        if found:
            return found
    raise ValueError('Chromium was not found. Install it with: pacman -S chromium (or set PONTE_CHROMIUM).')


def rd_main(argv):
    """Open the remote desktop client: Chromium in --app mode with a profile of its own."""
    from urllib.parse import quote
    parser = argparse.ArgumentParser(prog='ponte rd', description='Control this PC or a paired device from a desktop window (Chromium app with its own profile; Keyboard Lock in full screen).')
    parser.add_argument('device', nargs='?', help='Device name or node id (./ponte mesh list). Default: this PC.')
    parser.add_argument('--monitor', help='Monitor to show first (e.g. DP-3).')
    parser.add_argument('--print-url', action='store_true', help='Only print the URL (it carries the pairing key).')
    args = parser.parse_args(argv)
    config_file, _, _ = paths()
    config = load_config(config_file)
    data = absolute(os.environ.get('OMARCHY_REMOTE_DATA', config['dataDir']), 'dataDir')
    token = (data / 'token').read_text().strip()
    if not re.fullmatch(r'[a-zA-Z0-9_-]{32,128}', token):
        raise ValueError('Invalid pairing token.')
    origin = local_origin(config)
    node = rd_node(origin, token, args.device) if args.device else ''
    fragment = f'pair={token}'
    if node:
        fragment += f'&node={node}'
    if args.monitor:
        fragment += f'&monitor={quote(args.monitor, safe="")}'
    url = f'{origin}/rd.html#{fragment}'
    if args.print_url:
        print(url)
        return
    browser = rd_browser()
    home = absolute(os.environ.get('HOME', str(Path.home())), 'HOME')
    state_home = absolute(os.environ.get('XDG_STATE_HOME', str(home / '.local/state')), 'XDG_STATE_HOME')
    profile = state_home / 'ponte' / 'rd-chromium'
    private_dir(profile)
    # Its own profile, never the owner's browser; GPU stays on (WebCodecs decodes
    # in hardware and the canvas presents without waiting for vsync).
    # The profile keeps no passwords: basic store, so no keyring prompt appears.
    command = [browser, f'--app={url}', f'--user-data-dir={profile}', '--class=ponte-rd', '--no-first-run', '--no-default-browser-check', '--password-store=basic']
    subprocess.Popen(command, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
    print(f"Remote desktop opening for {args.device or 'this PC'} (profile {profile}). Release the control with Ctrl+Alt+Shift or by holding Esc.")


def ctl_main(argv):
    """Replace Python with the HTTP client, keeping signals and exit codes."""
    node = os.environ.get('PONTE_NODE', 'node')
    helper = ROOT / 'bin' / 'ponte-ctl.mjs'
    try:
        os.execvp(node, [node, str(helper), *argv])
    except OSError:
        print(json.dumps({'schemaVersion': 1, 'ok': False, 'error': {
            'code': 'NODE_UNAVAILABLE',
            'message': 'Node.js 22+ was not found. Install it or set PONTE_NODE.'
        }}))
        raise SystemExit(3)


def main():
    os.umask(0o077)
    if sys.argv[1:2] == ['desktop']:
        from desktop.__main__ import main as desktop_main
        raise SystemExit(desktop_main(sys.argv[2:]))
    if sys.argv[1:2] == ['ctl']:
        ctl_main(sys.argv[2:])
        return
    if sys.argv[1:2] == ['phone']:
        phone_main(sys.argv[2:])
        return
    if sys.argv[1:2] == ['pc']:
        pc_main(sys.argv[2:])
        return
    if sys.argv[1:2] == ['mesh']:
        mesh_main(sys.argv[2:])
        return
    if sys.argv[1:2] == ['rd']:
        rd_main(sys.argv[2:])
        return
    parser = argparse.ArgumentParser(description=__doc__, epilog='Desktop app: ./ponte desktop (control Android from this PC). Agent control: ./ponte ctl help. Offline discovery: ./ponte ctl schema or ./ponte desktop schema. Remote desktop: ./ponte rd [device]. Other groups: ./ponte pc --help, ./ponte phone --help and ./ponte mesh --help.')
    parser.add_argument('command', choices=['setup', 'install', 'uninstall', 'start', 'stop', 'restart', 'status', 'logs', 'doctor', 'renew-cert', 'pair', 'serve', 'android-config'])
    parser.add_argument('--local-only', action='store_true', help='Set up HTTP loopback only, without Tailscale or TLS.')
    parser.add_argument('--tailscale-ip', help='Explicit canonical Tailscale IPv4 instead of automatic detection.')
    parser.add_argument('--http-port', type=port, default=8787)
    parser.add_argument('--native-port', type=port, default=8788)
    parser.add_argument('--url', help='App URL for an explicitly requested pairing link.')
    args = parser.parse_args()
    config_file, data, config_home = paths()
    if args.command == 'setup':
        if args.local_only and args.tailscale_ip:
            parser.error('--local-only and --tailscale-ip cannot be combined.')
        setup(args)
    elif args.command == 'install':
        install(config_file, config_home)
    elif args.command == 'uninstall':
        uninstall(config_home)
    elif args.command in ['start', 'stop', 'restart', 'status']:
        run('systemctl', '--user', args.command, SERVICE)
        if args.command == 'stop':
            run('systemctl', '--user', 'stop', 'ponte-input.service')
    elif args.command == 'logs':
        run('journalctl', '--user', '-u', SERVICE, '-n', '40', '--no-pager')
    elif args.command == 'doctor':
        raise SystemExit(doctor(config_file))
    elif args.command == 'renew-cert':
        renew_certificate(config_file)
    else:
        config = load_config(config_file)
        if args.command == 'pair':
            from urllib.parse import urlsplit
            data = absolute(os.environ.get('OMARCHY_REMOTE_DATA', config['dataDir']), 'dataDir')
            token = (data / 'token').read_text().strip()
            if not re.fullmatch(r'[a-zA-Z0-9_-]{32,128}', token):
                raise ValueError('Invalid pairing token.')
            if not args.url:
                print(token)
                return
            url = args.url
            parsed = urlsplit(url)
            if not parsed.hostname or parsed.username or parsed.password or parsed.query or parsed.fragment or parsed.path not in ['', '/'] or parsed.scheme not in ['http', 'https']:
                raise ValueError('Use an HTTP(S) origin without credentials, a path, query or fragment.')
            if parsed.scheme == 'http' and parsed.hostname not in ['127.0.0.1', 'localhost', '::1']:
                raise ValueError('Remote pairing links require HTTPS.')
            print(url.rstrip('/') + '/#pair=' + token)
        elif args.command == 'android-config':
            tls = config.get('nativeTls')
            if not tls:
                raise ValueError('This installation is local-only; native TLS is not configured.')
            print(json.dumps({'schemaVersion': 1, 'upstream': f"https://{tls['host']}:{tls['port']}", 'certificatePath': tls['certFile'], 'caPath': tls['caFile']}))
        elif args.command == 'serve':
            name = dns_name()
            if not name or name not in config.get('trustedHosts', []):
                raise ValueError('Add this device’s Tailscale DNS name to trustedHosts and restart Ponte before enabling Serve.')
            host = config['http']['host']
            authority = f'[{host}]' if ':' in host else host
            run('tailscale', 'serve', '--bg', f"http://{authority}:{config['http']['port']}")


if __name__ == '__main__':
    try:
        main()
    except (OSError, RuntimeError, ValueError, KeyError, subprocess.SubprocessError) as error:
        print(str(error), file=sys.stderr)
        sys.exit(1)
