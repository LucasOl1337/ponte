#!/usr/bin/env python3
"""Set up and manage a private Ponte installation for the current Linux user."""
import argparse
import fcntl
import ipaddress
import json
import os
from pathlib import Path
import re
import secrets
import shutil
import stat
import subprocess
import time
import sys
import tempfile

ROOT = Path(__file__).resolve().parent
SERVICE = 'ponte-remote.service'
TAILNET = ipaddress.ip_network('100.64.0.0/10')


def absolute(value, label):
    result = Path(value)
    if not result.is_absolute() or any(ord(char) < 32 for char in str(result)):
        raise ValueError(f'{label} must be an absolute path without control characters.')
    return result


def paths():
    home = absolute(os.environ.get('HOME', str(Path.home())), 'HOME')
    config_home = absolute(os.environ.get('XDG_CONFIG_HOME', str(home / '.config')), 'XDG_CONFIG_HOME')
    state_home = absolute(os.environ.get('XDG_STATE_HOME', str(home / '.local/state')), 'XDG_STATE_HOME')
    config = absolute(os.environ.get('PONTE_CONFIG', str(config_home / 'ponte/config.json')), 'PONTE_CONFIG')
    data = absolute(os.environ.get('OMARCHY_REMOTE_DATA', str(state_home / 'ponte')), 'OMARCHY_REMOTE_DATA')
    return config, data, config_home


def outside_repo(target):
    if target.resolve().is_relative_to(ROOT):
        raise ValueError('Private configuration, keys and state must stay outside the repository.')


def private_dir(target):
    outside_repo(target)
    target.mkdir(mode=0o700, parents=True, exist_ok=True)
    if target.is_symlink() or not target.is_dir() or target.stat().st_uid != os.getuid():
        raise ValueError(f'Private directory must be owned by this user and not a symlink: {target}')
    target.chmod(0o700)


def private_json(target, value):
    private_dir(target.parent)
    descriptor, temporary = tempfile.mkstemp(prefix='.ponte-', dir=target.parent)
    try:
        with os.fdopen(descriptor, 'w') as stream:
            json.dump(value, stream, indent=2)
            stream.write('\n')
        os.replace(temporary, target)
    finally:
        Path(temporary).unlink(missing_ok=True)


def load_config(target):
    info = target.lstat()
    if not stat.S_ISREG(info.st_mode) or info.st_mode & 0o077 or info.st_uid != os.getuid() or info.st_size > 65536:
        raise ValueError('Ponte config must be a regular private file owned by this user, mode 0600.')
    value = json.loads(target.read_text())
    if not isinstance(value, dict) or value.get('schemaVersion') != 1:
        raise ValueError('Unsupported Ponte configuration schema.')
    return value


def run(*args, capture=False, timeout=30):
    return subprocess.run(args, check=True, text=True, capture_output=capture, timeout=timeout)


def tailscale_ip(value):
    try:
        parsed = ipaddress.IPv4Address(value)
    except ipaddress.AddressValueError as error:
        raise ValueError('Use a canonical Tailscale IPv4 address.') from error
    if parsed not in TAILNET or str(parsed) != value:
        raise ValueError('Use a canonical Tailscale IPv4 address in 100.64.0.0/10.')
    return str(parsed)


def detect_tailscale():
    addresses = run('tailscale', 'ip', '-4', capture=True).stdout.split()
    if len(addresses) != 1:
        raise ValueError('Could not detect one Tailscale IPv4 address. Connect Tailscale or use --local-only.')
    return tailscale_ip(addresses[0])


def dns_name():
    try:
        name = json.loads(run('tailscale', 'status', '--json', capture=True).stdout).get('Self', {}).get('DNSName', '').rstrip('.').lower()
        return name if re.fullmatch(r'[a-z0-9][a-z0-9.-]{0,252}', name) else None
    except (OSError, subprocess.SubprocessError, ValueError):
        return None


SERVER_CERT_DAYS = 365


def issue_server_certificate(directory, host, ca_key, ca_cert, server_key, server_cert):
    """Issue a one-year server certificate for host under the installation CA.

    The Android app pins the CA, so this can run again at renewal time without
    rebuilding the app. New files are written beside the old ones and swapped
    in only after they verify, so a failed run never leaves a broken listener.
    """
    request, extensions = directory / 'server.csr', directory / 'server.ext'
    new_key, new_cert = directory / 'server.key.new', directory / 'server.crt.new'
    extensions.write_text('\n'.join([
        'basicConstraints=critical,CA:FALSE', 'keyUsage=critical,digitalSignature,keyEncipherment',
        'extendedKeyUsage=serverAuth', f'subjectAltName=IP:{host}', '',
    ]))
    try:
        run('openssl', 'req', '-new', '-newkey', 'rsa:2048', '-nodes', '-sha256',
            '-keyout', str(new_key), '-out', str(request), '-subj', '/CN=Ponte server', capture=True)
        run('openssl', 'x509', '-req', '-in', str(request), '-CA', str(ca_cert), '-CAkey', str(ca_key),
            '-set_serial', str(secrets.randbits(128)), '-days', str(SERVER_CERT_DAYS), '-sha256', '-extfile', str(extensions), '-out', str(new_cert), capture=True)
        for target in [new_key, new_cert]:
            target.chmod(0o600)
        run('openssl', 'verify', '-CAfile', str(ca_cert), '-verify_ip', host, str(new_cert), capture=True)
        os.replace(new_key, server_key)
        os.replace(new_cert, server_cert)
    finally:
        for leftover in [request, extensions, new_key, new_cert]:
            leftover.unlink(missing_ok=True)


def make_tls(directory, host):
    private_dir(directory)
    ca_key, ca_cert = directory / 'ca.key', directory / 'ca.crt'
    server_key, server_cert = directory / 'server.key', directory / 'server.crt'
    if any(directory.iterdir()):
        raise ValueError(f'TLS directory is not empty; refusing to overwrite keys: {directory}')
    run('openssl', 'req', '-x509', '-newkey', 'rsa:2048', '-nodes', '-sha256', '-days', '3650',
        '-keyout', str(ca_key), '-out', str(ca_cert), '-subj', '/CN=Ponte installation CA',
        '-addext', 'basicConstraints=critical,CA:TRUE', '-addext', 'keyUsage=critical,keyCertSign,cRLSign', capture=True)
    for target in [ca_key, ca_cert]:
        target.chmod(0o600)
    issue_server_certificate(directory, host, ca_key, ca_cert, server_key, server_cert)
    return {'host': host, 'certFile': str(server_cert), 'keyFile': str(server_key), 'caFile': str(ca_cert)}


def renew_certificate(config_file):
    """Reissue the server certificate under the existing CA and restart the service."""
    config = load_config(config_file)
    tls = config.get('nativeTls')
    if not tls:
        raise ValueError('This installation is local-only; native TLS is not configured.')
    server_cert, server_key = Path(tls['certFile']), Path(tls['keyFile'])
    ca_cert = Path(tls.get('caFile', ''))
    ca_key = ca_cert.with_name('ca.key')
    directory = server_cert.parent
    if not (ca_cert.is_file() and ca_key.is_file()):
        raise ValueError('The installation CA is missing; a new CA needs ./ponte setup and a new APK.')
    if server_key.parent != directory or ca_cert.parent != directory:
        raise ValueError('TLS files must live in one private directory.')
    issue_server_certificate(directory, tls['host'], ca_key, ca_cert, server_key, server_cert)
    print(f'Server certificate renewed for {SERVER_CERT_DAYS} days: {server_cert}')
    print('The app keeps working: it pins the installation CA, not this certificate.')
    if subprocess.run(['systemctl', '--user', 'is-active', '--quiet', SERVICE]).returncode == 0:
        run('systemctl', '--user', 'restart', SERVICE)
        print('Ponte restarted with the new certificate.')
    else:
        print('Start Ponte to use it: ./ponte start')


def setup(args):
    config_file, data, _ = paths()
    private_dir(config_file.parent)
    with (config_file.parent / '.setup.lock').open('a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        if config_file.exists() or config_file.is_symlink():
            load_config(config_file)
            print(f'Existing configuration preserved: {config_file}')
            return
        host = None if args.local_only else tailscale_ip(args.tailscale_ip) if args.tailscale_ip else detect_tailscale()
        private_dir(data)
        token_file = data / 'token'
        if not token_file.exists():
            with token_file.open('x') as stream:
                stream.write(secrets.token_urlsafe(32) + '\n')
        if token_file.is_symlink() or not re.fullmatch(r'[a-zA-Z0-9_-]{32,128}\n?', token_file.read_text()):
            raise ValueError('Invalid existing token file; refusing to replace it.')
        token_file.chmod(0o600)
        config = {'schemaVersion': 1, 'dataDir': str(data), 'http': {'host': '127.0.0.1', 'port': args.http_port}, 'trustedHosts': [], 'nativeTls': None}
        if host:
            tls = make_tls(config_file.parent / 'tls' / secrets.token_hex(8), host)
            tls['port'] = args.native_port
            config['nativeTls'] = tls
            config['trustedHosts'].append(f'{host}:{args.native_port}')
            if not args.tailscale_ip:
                name = dns_name()
                if name:
                    config['trustedHosts'].append(name)
        private_json(config_file, config)
        print(f'Configuration created: {config_file}')
        print('No service was started. Run ./ponte install or ./start.sh when ready.')


def quoted_unit(value):
    return '"' + str(value).replace('\\', '\\\\').replace('"', '\\"').replace('%', '%%') + '"'


def install(config_file, config_home):
    load_config(config_file)
    commands = {name: shutil.which(name) for name in ['bash', 'node', 'ydotoold']}
    missing = [name for name, value in commands.items() if not value]
    if missing:
        raise ValueError('Install these commands first: ' + ', '.join(missing))
    units = config_home / 'systemd/user'
    units.mkdir(parents=True, exist_ok=True)
    input_unit = '\n'.join([
        '# Managed by Ponte', '[Unit]', 'Description=Ponte private input daemon', 'PartOf=graphical-session.target',
        'StartLimitIntervalSec=60', 'StartLimitBurst=3', '', '[Service]', 'Type=simple',
        'UMask=0077', 'ExecStart=' + quoted_unit(commands['ydotoold']) + ' -p %t/ponte-input.sock -P 0600',
        'Restart=on-failure', 'RestartSec=3', 'TimeoutStopSec=5', '',
    ])
    unit = '\n'.join([
        '# Managed by Ponte', '[Unit]', 'Description=Ponte remote desktop control', 'After=graphical-session.target', 'PartOf=graphical-session.target',
        'Wants=ponte-input.service', 'After=ponte-input.service',
        'StartLimitIntervalSec=60', 'StartLimitBurst=3', '', '[Service]', 'Type=simple', 'UMask=0077',
        'Environment=' + quoted_unit('PONTE_CONFIG=' + str(config_file)),
        'Environment=' + quoted_unit('PONTE_NODE=' + commands['node']),
        'Environment=' + quoted_unit('PATH=' + os.environ.get('PATH', '/usr/local/bin:/usr/bin:/bin')),
        'ExecCondition=' + quoted_unit(commands['node']) + ' ' + quoted_unit(ROOT / 'bin/check-config.mjs'),
        'ExecStart=' + quoted_unit(commands['bash']) + ' ' + quoted_unit(ROOT / 'start.sh'),
        'Restart=on-failure', 'RestartSec=3', 'TimeoutStopSec=20', '', '[Install]', 'WantedBy=graphical-session.target', '',
    ])
    files = [(units / 'ponte-input.service', input_unit), (units / SERVICE, unit)]
    for target, content in files:
        if target.is_symlink() or (target.exists() and target.read_text() != content):
            raise ValueError(f'Existing service differs; refusing to replace it: {target}')
    for target, content in files:
        target.write_text(content)
    run('systemctl', '--user', 'daemon-reload')
    run('systemctl', '--user', 'enable', '--now', SERVICE)
    print('Ponte installed for this user’s graphical session.')


def uninstall(config_home):
    units = config_home / 'systemd/user'
    targets = [units / SERVICE, units / 'ponte-input.service']
    present = [target for target in targets if target.exists() or target.is_symlink()]
    if not present:
        print('No Ponte services are installed. Private data was preserved.')
        return
    for target in present:
        if target.is_symlink() or not target.is_file() or not target.read_text().startswith('# Managed by Ponte\n'):
            raise ValueError(f'Refusing to remove an unmanaged service: {target}')
    if targets[0] in present:
        run('systemctl', '--user', 'disable', '--now', SERVICE)
    if targets[1] in present:
        run('systemctl', '--user', 'stop', 'ponte-input.service')
    for target in present:
        target.unlink()
    run('systemctl', '--user', 'daemon-reload')
    print('Ponte services removed. Configuration, certificates, token and recordings were preserved.')


def port(value):
    value = int(value)
    if not 1 <= value <= 65535:
        raise argparse.ArgumentTypeError('Port must be between 1 and 65535.')
    return value


DEFAULT_PHONE = '100.111.221.82:5555'
PHONE_NAME = 'redmi-note-13-pro-5g-1'


def phone_target(value):
    if not isinstance(value, str) or value.count(':') != 1:
        raise ValueError('Use a Tailscale IPv4 and port, for example 100.111.221.82:5555.')
    host, port_text = value.split(':')
    try:
        port_value = int(port_text)
    except ValueError as error:
        raise ValueError('The phone port must be an integer from 1 to 65535.') from error
    if not 1 <= port_value <= 65535:
        raise ValueError('The phone port must be an integer from 1 to 65535.')
    return f'{tailscale_ip(host)}:{port_value}'


def phone_code(value):
    if not re.fullmatch(r'\d{6,8}', value or ''):
        raise ValueError('The pairing code is the 6-digit number shown under Wireless debugging on the phone.')
    return value


def phone_state_file(data):
    return Path(data) / 'phone.json'


def load_phone_address(config_file, data):
    if Path(config_file).exists():
        try:
            saved = load_config(Path(config_file)).get('phone') or {}
            if isinstance(saved, dict) and saved.get('address'):
                return phone_target(saved['address'])
        except ValueError:
            pass
    state = phone_state_file(data)
    if state.exists():
        try:
            saved = json.loads(state.read_text())
            if isinstance(saved, dict) and saved.get('address'):
                return phone_target(saved['address'])
        except (OSError, ValueError):
            pass
    return DEFAULT_PHONE


def save_phone_address(config_file, data, address):
    address = phone_target(address)
    private_dir(Path(data))
    private_json(phone_state_file(data), {'address': address})
    target = Path(config_file)
    if target.exists() and not target.is_symlink():
        config = load_config(target)
        config['phone'] = {'address': address}
        private_json(target, config)
    return address


def command_path(name):
    return shutil.which(name)


def adb_device_state(serial, runner=run):
    try:
        output = runner('adb', 'devices', capture=True).stdout or ''
    except (OSError, subprocess.SubprocessError):
        return None
    for line in output.splitlines():
        parts = line.split()
        if len(parts) >= 2 and parts[0] == serial:
            return parts[1]
    return None


def tailscale_phone_online(ip, runner=run):
    try:
        status = json.loads(runner('tailscale', 'status', '--json', capture=True).stdout)
    except (OSError, subprocess.SubprocessError, ValueError, json.JSONDecodeError):
        return None
    for peer in (status.get('Peer') or {}).values():
        if ip in (peer.get('TailscaleIPs') or []):
            return bool(peer.get('Online'))
    return False


def scrcpy_command(serial, screen_off=False):
    command = ['scrcpy', '--window-title', 'Ponte', '--stay-awake', '--video-codec=h264', '--no-audio', '-s', serial]
    if screen_off:
        command.append('--turn-screen-off')
    return command


def phone_status(config_file, data, runner=run, which=command_path):
    address = load_phone_address(config_file, data)
    host = address.split(':')[0]
    adb = which('adb')
    scrcpy = which('scrcpy')
    lines = [
        f'Ponte phone control for {PHONE_NAME}',
        f'Default address: {DEFAULT_PHONE}',
        f'Last address: {address}',
        f'adb: {"yes — " + adb if adb else "no — install with: pacman -S android-tools"}',
        f'scrcpy: {"yes — " + scrcpy if scrcpy else "no — install with: pacman -S scrcpy"}',
    ]
    online = tailscale_phone_online(host, runner=runner)
    if online is True:
        lines.append(f'Tailscale: {host} is online')
    elif online is False:
        lines.append(f'Tailscale: {host} is not reachable. Open Tailscale on the phone.')
    else:
        lines.append('Tailscale: could not read `tailscale status`. Is Tailscale running on this PC?')
    if adb:
        state = adb_device_state(address, runner=runner)
        if state == 'device':
            lines.append(f'ADB: connected ({address})')
        elif state == 'unauthorized':
            lines.append('ADB: unauthorized. Accept the USB debugging prompt on the phone, or pair again.')
        elif state:
            lines.append(f'ADB: {state}. Try ./ponte phone connect {address}')
        else:
            lines.append(f'ADB: not connected. Run ./ponte phone connect {address}')
    else:
        lines.append('ADB: skipped until android-tools is installed.')
    lines.append('')
    lines.append('On the phone: Settings → System → Developer options → Wireless debugging.')
    lines.append('If ADB asks for a pairing code: ./ponte phone pair IP:PORT CODE')
    lines.append('Then: ./ponte phone view')
    print('\n'.join(lines))


def phone_connect(config_file, data, target, runner=run, which=command_path):
    if not which('adb'):
        raise ValueError('adb is not installed. Install it with: pacman -S android-tools')
    address = phone_target(target or load_phone_address(config_file, data))
    try:
        result = runner('adb', 'connect', address, capture=True)
    except subprocess.CalledProcessError as error:
        raise ValueError(
            f'Could not reach {address}. On the phone, open Wireless debugging and check the IP and port. If the port changed, run: ./ponte phone connect IP:PORT'
        ) from error
    text = ((result.stdout or '') + (result.stderr or '')).lower()
    if 'failed' in text or 'refused' in text or 'cannot' in text:
        raise ValueError(
            f'Could not reach {address}. On the phone, open Wireless debugging and check the IP and port. If the port changed, run: ./ponte phone connect IP:PORT'
        )
    save_phone_address(config_file, data, address)
    print(f'Connected to {address}. Saved as the last phone address.')
    print('Open the screen with: ./ponte phone view')


def phone_pair(config_file, data, target, code, runner=run, which=command_path):
    if not which('adb'):
        raise ValueError('adb is not installed. Install it with: pacman -S android-tools')
    address = phone_target(target)
    pairing_code = phone_code(code)
    try:
        result = runner('adb', 'pair', address, pairing_code, capture=True)
    except subprocess.CalledProcessError as error:
        raise ValueError(
            'Pairing failed. On the phone open Wireless debugging → Pair device with pairing code, then run: ./ponte phone pair IP:PORT CODE'
        ) from error
    text = ((result.stdout or '') + (result.stderr or '')).lower()
    if 'fail' in text or 'wrong' in text:
        raise ValueError(
            'Pairing failed. On the phone open Wireless debugging → Pair device with pairing code, then run: ./ponte phone pair IP:PORT CODE'
        )
    print(f'Paired with {address}. Next: ./ponte phone connect {DEFAULT_PHONE}')


# Waits between adb probes; tests set PONTE_TEST_FAST to skip them.
SLEEP = (lambda seconds: None) if os.environ.get('PONTE_TEST_FAST') else time.sleep


def adb_devices(runner=run):
    """[(serial, state)] as adb reports them; a TCP serial contains ':'."""
    try:
        output = runner('adb', 'devices', capture=True).stdout or ''
    except (OSError, subprocess.SubprocessError):
        return []
    devices = []
    for line in output.splitlines()[1:]:
        parts = line.split()
        if len(parts) >= 2 and not parts[0].startswith('*'):
            devices.append((parts[0], parts[1]))
    return devices


def adb_responds(serial, runner=run):
    try:
        result = runner('adb', '-s', serial, 'shell', 'echo', 'ponte', capture=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        return False
    return 'ponte' in (result.stdout or '')


def phone_ensure(config_file, data, runner=run, which=command_path, quiet=False, sleep=SLEEP):
    """Make the phone reachable over adb through Tailscale alone.

    adbd only listens on TCP after `adb tcpip PORT`, which is lost on reboot.
    So: connect to the saved Tailscale address; if that fails, use whatever
    transport is up right now (USB, or a Wireless-debugging session) just to
    switch adbd to the fixed port, then come back over Tailscale. Prints the
    single manual step left when nothing is reachable."""
    if not which('adb'):
        raise ValueError('adb is not installed. Install it with: pacman -S android-tools')
    address = load_phone_address(config_file, data)
    host, port = address.split(':')
    say = (lambda *_: None) if quiet else print
    if adb_device_state(address, runner=runner) == 'device' and adb_responds(address, runner=runner):
        say(f'Phone reachable over Tailscale at {address}.')
        return address
    online = tailscale_phone_online(host, runner=runner)
    if online is False:
        say(f'Tailscale says {host} is offline; the phone must be on the tailnet before adb can reach it.')
    try:
        runner('adb', 'disconnect', address, capture=True, timeout=10)
    except (OSError, subprocess.SubprocessError):
        pass
    try:
        runner('adb', 'connect', address, capture=True, timeout=20)
    except (OSError, subprocess.SubprocessError):
        pass
    if adb_device_state(address, runner=runner) == 'device' and adb_responds(address, runner=runner):
        save_phone_address(config_file, data, address)
        say(f'Phone reachable over Tailscale at {address}.')
        return address
    # No TCP listener: enable it through any other transport that is up.
    others = [serial for serial, state in adb_devices(runner=runner) if serial != address and state == 'device' and not serial.startswith('emulator-')]
    for serial in others:
        if not adb_responds(serial, runner=runner):
            continue
        try:
            runner('adb', '-s', serial, 'tcpip', port, capture=True, timeout=20)
        except (OSError, subprocess.SubprocessError):
            continue
        sleep(2)
        for _ in range(5):
            try:
                runner('adb', 'connect', address, capture=True, timeout=20)
            except (OSError, subprocess.SubprocessError):
                pass
            if adb_device_state(address, runner=runner) == 'device' and adb_responds(address, runner=runner):
                save_phone_address(config_file, data, address)
                say(f'adbd switched to TCP port {port} through {serial}; phone reachable over Tailscale at {address}.')
                return address
            sleep(1)
    unauthorized = [serial for serial, state in adb_devices(runner=runner) if state == 'unauthorized']
    if unauthorized:
        raise ValueError(f'adb is not authorized on {unauthorized[0]}: accept the USB debugging prompt on the phone, then run ./ponte phone ensure again.')
    raise ValueError(
        f'Cannot reach the phone at {address} and no other adb transport is up. adbd stops listening on TCP after a reboot: '
        'plug the phone in once, or on Wi-Fi turn on Wireless debugging and run ./ponte phone connect IP:PORT (pairing is remembered), '
        'then ./ponte phone ensure switches it back to the fixed port over Tailscale.'
    )


def phone_unlock_file(data):
    return Path(data) / 'phone-unlock'


def phone_wake(config_file, data, runner=run, which=command_path, sleep=SLEEP):
    """Wake the phone and get past the lock screen so an agent can act on it.

    The screen wakes with KEYCODE_WAKEUP; a swipe dismisses a lock without
    credentials. If phone-unlock (0600, in the data dir) holds a PIN or
    password, it is typed after the swipe. Nothing is typed when the phone is
    already unlocked."""
    address = phone_ensure(config_file, data, runner=runner, which=which, quiet=True, sleep=sleep)
    adb = lambda *args, **kw: runner('adb', '-s', address, *args, capture=True, timeout=15, **kw)
    def locked():
        try:
            output = adb('shell', 'dumpsys', 'window').stdout or ''
        except (OSError, subprocess.SubprocessError):
            return None
        return 'mDreamingLockscreen=true' in output or 'NotificationShade' in output.split('mCurrentFocus=')[-1].split('\n')[0]
    def dozing():
        try:
            return 'mWakefulness=Awake' not in (adb('shell', 'dumpsys', 'power').stdout or '')
        except (OSError, subprocess.SubprocessError):
            return False
    # HyperOS ignores KEYCODE_WAKEUP while dozing; the power key does wake it.
    if dozing():
        adb('shell', 'input', 'keyevent', 'KEYCODE_POWER')
        sleep(0.8)
    try:
        if 'ScreenOnProximitySensorGuide' in (adb('shell', 'dumpsys', 'window').stdout or ''):
            adb('shell', 'input', 'keyevent', 'KEYCODE_VOLUME_UP'); sleep(0.5)
    except (OSError, subprocess.SubprocessError):
        pass
    if not locked():
        print(f'Phone awake and unlocked ({address}).')
        return address
    adb('shell', 'input', 'swipe', '600', '2200', '600', '800', '250')
    sleep(0.8)
    secret_file = phone_unlock_file(data)
    if locked() and secret_file.exists():
        if secret_file.stat().st_mode & 0o077:
            raise ValueError(f'{secret_file} must be private (chmod 600).')
        secret = secret_file.read_text().strip()
        if secret:
            # The secret never appears on a command line of this PC: adb's shell
            # gets it as one argument; on the phone it is typed into the lock UI.
            adb('shell', 'input', 'text', secret)
            adb('shell', 'input', 'keyevent', 'KEYCODE_ENTER')
            sleep(1.2)
    if locked():
        raise ValueError(
            f'The phone is still locked. Put the PIN in {secret_file} (chmod 600) so ./ponte phone wake can enter it, or disable the lock screen for this phone.'
        )
    print(f'Phone awake and unlocked ({address}).')
    return address


PONTE_ACTIVITY = 'app.ponte.omarchy/.MainActivity'


def phone_app(config_file, data, runner=run, which=command_path, sleep=SLEEP):
    """Bring Ponte to the front over Tailscale, screen on, above the lock screen.

    The activity started with the agent extra shows above the keyguard and
    turns the screen on; it finishes itself when it leaves the foreground.
    HyperOS may show its 'do not cover the earpiece' guide on wake, which
    Volume Up dismisses."""
    address = phone_ensure(config_file, data, runner=runner, which=which, quiet=True, sleep=sleep)
    adb = lambda *args, **kw: runner('adb', '-s', address, *args, capture=True, timeout=20, **kw)
    def focus():
        try:
            output = adb('shell', 'dumpsys', 'window').stdout or ''
        except (OSError, subprocess.SubprocessError):
            return ''
        return output.split('mCurrentFocus=')[-1].split('\n')[0] if 'mCurrentFocus=' in output else ''
    # HyperOS/MIUI gates "show on lock screen" behind its own app op (10020),
    # rejected by default; other Androids have no such op and the call fails
    # harmlessly.
    try:
        adb('shell', 'appops', 'set', 'app.ponte.omarchy', '10020', 'allow')
    except (OSError, subprocess.SubprocessError):
        pass
    for attempt in range(3):
        adb('shell', 'am', 'start', '-n', PONTE_ACTIVITY, '--ez', 'ponte.agent', 'true')
        for _ in range(8):
            sleep(0.5)
            current = focus()
            if 'ScreenOnProximitySensorGuide' in current:
                adb('shell', 'input', 'keyevent', 'KEYCODE_VOLUME_UP')
                continue
            if 'app.ponte.omarchy' in current:
                print(f'Ponte is in front on {address} (screen on, above the lock screen).')
                return address
    raise ValueError(f'Ponte did not come to the front on {address}; current window: {focus() or "unknown"}. Is the installed app 0.1.0-alpha.19 or newer?')


PHONE_TIMER = 'ponte-phone.timer'


def phone_timer(config_file, config_home, enable, runner=run, which=command_path):
    """A user timer that runs `ponte phone ensure --quiet` every two minutes,
    so the phone is already an adb device when an agent needs it, and the
    Tailscale link is re-established after the phone changes networks."""
    units = Path(config_home) / 'systemd/user'
    service_file, timer_file = units / 'ponte-phone.service', units / PHONE_TIMER
    if not enable:
        present = [f for f in (timer_file, service_file) if f.exists() or f.is_symlink()]
        for f in present:
            if f.is_symlink() or not f.read_text().startswith('# Managed by Ponte\n'):
                raise ValueError(f'Refusing to remove an unmanaged unit: {f}')
        if timer_file in present:
            runner('systemctl', '--user', 'disable', '--now', PHONE_TIMER)
        for f in present:
            f.unlink()
        runner('systemctl', '--user', 'daemon-reload')
        print('Phone keepalive timer removed.')
        return
    python = which('python3') or sys.executable
    if not which('adb'):
        raise ValueError('adb is not installed. Install it with: pacman -S android-tools')
    units.mkdir(parents=True, exist_ok=True)
    service = '\n'.join([
        '# Managed by Ponte', '[Unit]', 'Description=Ponte phone adb link over Tailscale', '', '[Service]', 'Type=oneshot',
        'Environment=' + quoted_unit('PONTE_CONFIG=' + str(config_file)),
        'Environment=' + quoted_unit('PATH=' + os.environ.get('PATH', '/usr/local/bin:/usr/bin:/bin')),
        'ExecStart=' + quoted_unit(python) + ' ' + quoted_unit(ROOT / 'ponte') + ' phone ensure --quiet', '',
    ])
    timer = '\n'.join([
        '# Managed by Ponte', '[Unit]', 'Description=Keep the phone reachable over adb through Tailscale', '',
        '[Timer]', 'OnBootSec=1min', 'OnUnitActiveSec=2min', 'AccuracySec=20s', '', '[Install]', 'WantedBy=timers.target', '',
    ])
    for target, content in ((service_file, service), (timer_file, timer)):
        if target.is_symlink() or (target.exists() and not target.read_text().startswith('# Managed by Ponte\n')):
            raise ValueError(f'Existing unit differs; refusing to replace it: {target}')
        target.write_text(content)
    runner('systemctl', '--user', 'daemon-reload')
    runner('systemctl', '--user', 'enable', '--now', PHONE_TIMER)
    print(f'Phone keepalive timer installed ({PHONE_TIMER}, every 2 min).')


def phone_install(config_file, data, apk=None, runner=run, which=command_path, sleep=SLEEP):
    """Install the built APK on the phone over Tailscale, then confirm the version it reports."""
    address = phone_ensure(config_file, data, runner=runner, which=which, quiet=True, sleep=sleep)
    target = Path(apk) if apk else Path(__file__).resolve().parent / '.work' / 'Ponte.apk'
    if not target.is_file():
        raise ValueError(f'{target} not found. Build it with ./android/build.sh')
    try:
        result = runner('adb', '-s', address, 'install', '-r', str(target), capture=True, timeout=300)
        text = (result.stdout or '') + (result.stderr or '')
    except subprocess.CalledProcessError as error:
        text = (error.stdout or '') + (error.stderr or '')
    if 'Success' not in text:
        detail = text.strip().splitlines()[-1] if text.strip() else 'no output from adb'
        raise ValueError(f'Install failed: {detail}')
    probe = runner('adb', '-s', address, 'shell', 'dumpsys', 'package', 'app.ponte.omarchy', capture=True, timeout=30)
    match = re.search(r'versionName=(\S+)', probe.stdout or '')
    print(f'Installed {target.name} on {address}; the phone now reports Ponte {match.group(1) if match else "?"}.')
    return address


def phone_view(config_file, data, screen_off=False, runner=run, which=command_path):
    if not which('scrcpy'):
        raise ValueError('scrcpy is not installed. Install it with: pacman -S scrcpy')
    if not which('adb'):
        raise ValueError('adb is not installed. Install it with: pacman -S android-tools')
    address = load_phone_address(config_file, data)
    command = scrcpy_command(address, screen_off=screen_off)
    try:
